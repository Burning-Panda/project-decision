# Decision Log - environment configuration
#
#   cp .env.example .env     (Bun loads .env automatically; never commit .env)
#   bun install && bun run start:dev
#
# Nothing is required to start: without a storage option the server runs in memory. Persisting data needs SECRETS_KEY.

# ----------------------------------------------------------------------------------------
# Required as soon as data is persisted
# ----------------------------------------------------------------------------------------

# 32-byte key (base64 or hex) that encrypts webhook signing secrets at rest. The server refuses
# to start without it whenever data is persisted (any storage option below).
# Generate one with:   bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
# Keep it in your secret manager, not in the database. Losing it makes stored secrets unrecoverable.
SECRETS_KEY=

# ----------------------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------------------
PORT=3000

# Public base URL; makes notification emails link back to the decision. e.g. https://decisions.example.com
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------------------
# Storage - set AT MOST ONE of the three. Leave all unset for in-memory (data lost on restart).
# ----------------------------------------------------------------------------------------

# SQLite file (durable, single node). Good default for local development once SqliteStore is implemented.
# DATABASE_FILE=./data/decision-log.db

# PostgreSQL (durable; only one instance may hold the database at a time).
# DATABASE_URL=postgres://user:pass@localhost:5432/decisions
# Schema the tables live in (lower-case letters, digits, underscore).
# DATABASE_SCHEMA=decision_log

# JSON snapshot rewritten on every write (small deployments / demos only).
# DATA_FILE=./data/data.json

# ----------------------------------------------------------------------------------------
# Secret key rotation (optional)
# ----------------------------------------------------------------------------------------
# To rotate: put the NEW key in SECRETS_KEY and the old key(s), comma separated, here. On startup
# everything is re-encrypted under the new key; the old one can then be removed.
# SECRETS_KEY_PREVIOUS=

# ----------------------------------------------------------------------------------------
# Email notifications (optional; unset SMTP_URL = email disabled)
# ----------------------------------------------------------------------------------------
# smtp://user:pass@host:587?starttls=required   or   smtps://user:pass@host:465   (URL-encode credentials)
# SMTP_URL=
# Required when SMTP_URL is set. Must be allowed by your provider (SPF/DKIM).
# EMAIL_FROM=Decision Log <noreply@example.com>
# EMAIL_REPLY_TO=
# APP_NAME=Decision Log

# ----------------------------------------------------------------------------------------
# Webhooks (optional)
# ----------------------------------------------------------------------------------------
# Allow webhook targets on private/loopback addresses (SSRF protection off). Local development ONLY.
# WEBHOOK_ALLOW_PRIVATE=1

# ----------------------------------------------------------------------------------------
# Tests (optional)
# ----------------------------------------------------------------------------------------
# Enables the PostgreSQL-only specs; each test uses its own throwaway schema. Without it they are skipped.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
